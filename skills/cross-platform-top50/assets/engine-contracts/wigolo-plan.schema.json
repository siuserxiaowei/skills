{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "top50-wigolo-plan/v2",
  "title": "HMAC-authenticated immutable Wigolo execution plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "adapter_version",
    "run_id",
    "operation",
    "normalized_request",
    "request_digest_sha256",
    "probe_id",
    "probe_digest_sha256",
    "executable",
    "backend",
    "argv",
    "timeout_seconds",
    "policy",
    "diagnostics",
    "auth_key_id",
    "plan_digest_sha256",
    "plan_hmac_sha256"
  ],
  "properties": {
    "contract_version": {"const": "top50-wigolo-plan/v2"},
    "adapter_version": {"const": "2.1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "operation": {"enum": ["discovery", "fetch", "cache", "watch"]},
    "normalized_request": {"$ref": "#/$defs/request"},
    "request_digest_sha256": {"$ref": "#/$defs/sha256"},
    "probe_id": {"type": "string", "pattern": "^wigolo-probe-[0-9a-f]{24}$"},
    "probe_digest_sha256": {"$ref": "#/$defs/sha256"},
    "executable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "backend": {"$ref": "#/$defs/backend"},
    "argv": {"type": "array", "minItems": 4, "items": {"type": "string"}},
    "timeout_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 300},
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_authority", "curator_authority", "output_class", "watch_access"],
      "properties": {
        "evidence_authority": {"const": "none"},
        "curator_authority": {"const": "none"},
        "output_class": {"const": "discovery_only"},
        "watch_access": {"const": "list_only"}
      }
    },
    "diagnostics": {"type": "array", "items": {"$ref": "#/$defs/diagnostic"}},
    "auth_key_id": {"type": "string", "pattern": "^wigolo-key-[0-9a-f]{24}$"},
    "plan_digest_sha256": {"$ref": "#/$defs/sha256"},
    "plan_hmac_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version", "run_id", "selection_mode", "operation",
        "allow_experimental_cjk", "timeout_seconds", "payload"
      ],
      "properties": {
        "contract_version": {"const": "top50-wigolo-request/v2"},
        "run_id": {"type": "string", "minLength": 1},
        "enabled": {"const": true},
        "selection_mode": {"const": "explicit"},
        "operation": {"enum": ["discovery", "fetch", "cache", "watch"]},
        "allow_experimental_cjk": {"type": "boolean"},
        "timeout_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 300},
        "payload": {"type": "object"}
      },
      "allOf": [
        {
          "if": {"properties": {"operation": {"const": "discovery"}}},
          "then": {"properties": {"payload": {"$ref": "#/$defs/discovery"}}}
        },
        {
          "if": {"properties": {"operation": {"const": "fetch"}}},
          "then": {"properties": {"payload": {"$ref": "#/$defs/fetch"}}}
        },
        {
          "if": {"properties": {"operation": {"const": "cache"}}},
          "then": {"properties": {"payload": {"$ref": "#/$defs/cache"}}}
        },
        {
          "if": {"properties": {"operation": {"const": "watch"}}},
          "then": {"properties": {"payload": {"$ref": "#/$defs/watch"}}}
        }
      ]
    },
    "domains": {
      "type": "array", "minItems": 1, "maxItems": 50, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "discovery": {
      "type": "object", "additionalProperties": false, "required": ["query"],
      "properties": {
        "query": {"type": "string", "minLength": 1},
        "max_results": {"type": "integer", "minimum": 1, "maximum": 50},
        "from_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "to_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "include_domains": {"$ref": "#/$defs/domains"},
        "exclude_domains": {"$ref": "#/$defs/domains"}
      }
    },
    "fetch": {
      "type": "object", "additionalProperties": false, "required": ["url"],
      "properties": {
        "url": {"type": "string", "pattern": "^https?://"},
        "max_chars": {"type": "integer", "minimum": 1, "maximum": 200000},
        "section": {"type": "string", "minLength": 1}
      }
    },
    "cache": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["action"],
          "properties": {"action": {"const": "stats"}}
        },
        {
          "type": "object", "additionalProperties": false, "required": ["action", "query"],
          "properties": {
            "action": {"const": "search"}, "query": {"type": "string", "minLength": 1},
            "url_pattern": {"type": "string", "minLength": 1},
            "since": {"type": "string", "minLength": 1},
            "limit": {"type": "integer", "minimum": 1, "maximum": 50},
            "max_tokens_out": {"type": "integer", "minimum": 1, "maximum": 100000}
          }
        }
      ]
    },
    "watch": {
      "type": "object", "additionalProperties": false, "required": ["action"],
      "properties": {"action": {"const": "list"}}
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "license", "integration_boundary"],
      "properties": {
        "id": {"const": "wigolo"},
        "version": {"type": "string", "pattern": "^0\\.2\\.\\d+(?:[-+][0-9A-Za-z.-]+)?$"},
        "license": {"const": "AGPL-3.0-only"},
        "integration_boundary": {"const": "separate_process"}
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "level", "message"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "level": {"enum": ["info", "warning", "error"]},
        "message": {"type": "string", "minLength": 1}
      }
    }
  }
}
