{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "top50-wigolo-result/v3",
  "title": "HMAC-authenticated normalized Wigolo adapter result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "adapter_version",
    "run_id",
    "operation",
    "status",
    "outcome",
    "backend",
    "argv",
    "plan_digest_sha256",
    "returncode",
    "duration_ms",
    "data",
    "diagnostics",
    "result_digest_sha256",
    "auth_key_id",
    "result_hmac_sha256"
  ],
  "properties": {
    "contract_version": {"const": "top50-wigolo-result/v3"},
    "adapter_version": {"const": "2.1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "operation": {"enum": ["discovery", "fetch", "cache", "watch", "unknown"]},
    "status": {"enum": ["complete", "blocked", "failed"]},
    "outcome": {
      "enum": [
        "success",
        "disabled",
        "invalid_request",
        "invalid_plan",
        "automatic_selection_rejected",
        "experimental_cjk_requires_opt_in",
        "policy_rejected",
        "backend_not_ready",
        "backend_error",
        "invalid_backend_output",
        "executable_mismatch",
        "execution_failed",
        "timeout"
      ]
    },
    "backend": {"$ref": "#/$defs/backend"},
    "argv": {"type": "array", "items": {"type": "string"}},
    "plan_digest_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "returncode": {"type": ["integer", "null"]},
    "duration_ms": {"type": "integer", "minimum": 0},
    "data": {},
    "diagnostics": {"type": "array", "items": {"$ref": "#/$defs/diagnostic"}},
    "result_digest_sha256": {"$ref": "#/$defs/sha256"},
    "auth_key_id": {"type": "string", "pattern": "^wigolo-key-[0-9a-f]{24}$"},
    "result_hmac_sha256": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {
      "if": {"properties": {"outcome": {"const": "success"}}, "required": ["outcome"]},
      "then": {"properties": {"status": {"const": "complete"}, "data": {"type": "object"}}},
      "else": {"properties": {"status": {"enum": ["blocked", "failed"]}, "data": {"type": "null"}}}
    },
    {
      "if": {
        "properties": {"outcome": {"const": "success"}, "operation": {"const": "discovery"}},
        "required": ["outcome", "operation"]
      },
      "then": {"properties": {"data": {"$ref": "#/$defs/discoveryData"}}}
    },
    {
      "if": {
        "properties": {"outcome": {"const": "success"}, "operation": {"const": "fetch"}},
        "required": ["outcome", "operation"]
      },
      "then": {"properties": {"data": {"$ref": "#/$defs/fetchData"}}}
    },
    {
      "if": {
        "properties": {"outcome": {"const": "success"}, "operation": {"const": "cache"}},
        "required": ["outcome", "operation"]
      },
      "then": {"properties": {"data": {"$ref": "#/$defs/cacheData"}}}
    },
    {
      "if": {
        "properties": {"outcome": {"const": "success"}, "operation": {"const": "watch"}},
        "required": ["outcome", "operation"]
      },
      "then": {"properties": {"data": {"$ref": "#/$defs/watchData"}}}
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authority": {
      "type": "object",
      "required": ["evidence_authority", "curator_authority"],
      "properties": {
        "evidence_authority": {"const": "none"},
        "curator_authority": {"const": "none"}
      }
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "license", "integration_boundary"],
      "properties": {
        "id": {"const": "wigolo"},
        "version": {"type": ["string", "null"]},
        "license": {"const": "AGPL-3.0-only"},
        "integration_boundary": {"const": "separate_process"}
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "level", "message"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "level": {"enum": ["info", "warning", "error"]},
        "message": {"type": "string", "minLength": 1}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id", "source_rank", "title", "url", "snippet", "relevance_score",
        "published_at", "author", "evidence_status", "curator_accepted"
      ],
      "properties": {
        "candidate_id": {"type": "string", "pattern": "^wigolo-[0-9a-f]{24}$"},
        "source_rank": {"type": "integer", "minimum": 1},
        "title": {"type": "string", "minLength": 1},
        "url": {"type": "string", "pattern": "^https?://"},
        "snippet": {"type": "string", "minLength": 1},
        "relevance_score": {"type": "number", "minimum": 0, "maximum": 1},
        "published_at": {"type": ["string", "null"]},
        "author": {"type": ["string", "null"]},
        "evidence_status": {"const": "discovery_only"},
        "curator_accepted": {"const": false}
      }
    },
    "discoveryData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_authority", "curator_authority", "query", "engines_used", "total_time_ms", "candidates"],
      "properties": {
        "evidence_authority": {"const": "none"},
        "curator_authority": {"const": "none"},
        "query": {"type": "string", "minLength": 1},
        "engines_used": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "total_time_ms": {"type": "number", "minimum": 0},
        "candidates": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/candidate"}}
      }
    },
    "fetchData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_authority", "curator_authority", "evidence_status", "requested_url", "url", "title",
        "content", "content_sha256", "links", "images", "cached", "http_status", "acquisition"
      ],
      "properties": {
        "evidence_authority": {"const": "none"},
        "curator_authority": {"const": "none"},
        "evidence_status": {"const": "discovery_only"},
        "requested_url": {"type": "string", "pattern": "^https?://"},
        "url": {"type": "string", "pattern": "^https?://"},
        "title": {"type": "string", "minLength": 1},
        "content": {"type": "string", "minLength": 1},
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "links": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^https?://"}},
        "images": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^https?://"}},
        "cached": {"const": false},
        "http_status": {"type": ["integer", "null"], "minimum": 200, "maximum": 399},
        "acquisition": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "backend_id", "render_js"],
          "properties": {
            "method": {"const": "direct_http"},
            "backend_id": {"const": "wigolo"},
            "render_js": {"const": "never"}
          }
        }
      }
    },
    "cacheData": {
      "type": "object",
      "oneOf": [
        {
          "additionalProperties": false,
          "required": ["evidence_authority", "curator_authority", "action", "stats"],
          "properties": {
            "evidence_authority": {"const": "none"},
            "curator_authority": {"const": "none"},
            "action": {"const": "stats"},
            "stats": {
              "type": "object",
              "additionalProperties": false,
              "required": ["total_urls", "total_size_mb", "oldest", "newest"],
              "properties": {
                "total_urls": {"type": "integer", "minimum": 0},
                "total_size_mb": {"type": "number", "minimum": 0},
                "oldest": {"type": "string"},
                "newest": {"type": "string"}
              }
            }
          }
        },
        {
          "additionalProperties": false,
          "required": ["evidence_authority", "curator_authority", "action", "query", "results"],
          "properties": {
            "evidence_authority": {"const": "none"},
            "curator_authority": {"const": "none"},
            "action": {"const": "search"},
            "query": {"type": "string", "minLength": 1},
            "results": {
              "type": "array",
              "items": {"$ref": "#/$defs/cacheResult"}
            }
          }
        }
      ]
    },
    "cacheResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "title", "markdown", "content_sha256", "fetched_at", "evidence_status"],
      "properties": {
        "url": {"type": "string", "pattern": "^https?://"},
        "title": {"type": "string", "minLength": 1},
        "markdown": {"type": "string", "minLength": 1},
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "fetched_at": {"type": "string", "minLength": 1},
        "evidence_status": {"const": "discovery_only"}
      }
    },
    "watchData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_authority", "curator_authority", "action", "jobs"],
      "properties": {
        "evidence_authority": {"const": "none"},
        "curator_authority": {"const": "none"},
        "action": {"const": "list"},
        "jobs": {"type": "array", "items": {"$ref": "#/$defs/watchJob"}}
      }
    },
    "watchJob": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "url", "interval_seconds", "status", "notification", "created_at", "selector"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "url": {"type": "string", "pattern": "^https?://"},
        "interval_seconds": {"type": "integer", "minimum": 60},
        "status": {"enum": ["active", "paused", "errored"]},
        "notification": {"type": ["string", "null"]},
        "created_at": {"type": ["string", "integer", "number"]},
        "selector": {"type": ["string", "null"]}
      }
    }
  }
}
