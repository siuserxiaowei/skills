{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "top50-hengzong-request/v1",
  "title": "Cross-platform Top 50 horizontal/vertical research request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "run_id",
    "brief_date",
    "as_of",
    "goal",
    "scope",
    "query_bounds",
    "producer"
  ],
  "properties": {
    "contract_version": {"const": "top50-hengzong-request/v1"},
    "run_id": {"type": "string", "minLength": 1},
    "brief_date": {"type": "string", "format": "date"},
    "as_of": {"type": "string", "format": "date-time"},
    "goal": {"$ref": "#/$defs/goal"},
    "scope": {"$ref": "#/$defs/scope"},
    "query_bounds": {"$ref": "#/$defs/queryBounds"},
    "producer": {"$ref": "#/$defs/producer"}
  },
  "$defs": {
    "nonempty": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "goal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "objective", "audience", "decision"],
      "properties": {
        "type": {
          "enum": ["opportunity", "decision", "landscape", "diagnosis"]
        },
        "objective": {"$ref": "#/$defs/nonempty"},
        "audience": {"$ref": "#/$defs/nonempty"},
        "decision": {"$ref": "#/$defs/nonempty"}
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_date", "end_date", "geographies", "languages"],
      "properties": {
        "start_date": {"type": "string", "format": "date"},
        "end_date": {"type": "string", "format": "date"},
        "geographies": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/nonempty"}
        },
        "languages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/nonempty"}
        }
      }
    },
    "queryBounds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_geo_language_cells",
        "max_queries_per_group",
        "max_total_queries"
      ],
      "properties": {
        "max_geo_language_cells": {
          "type": "integer",
          "minimum": 1,
          "maximum": 24
        },
        "max_queries_per_group": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "max_total_queries": {
          "type": "integer",
          "minimum": 1,
          "maximum": 192
        }
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine_id", "engine_version", "worker_ids"],
      "properties": {
        "engine_id": {"$ref": "#/$defs/nonempty"},
        "engine_version": {"$ref": "#/$defs/nonempty"},
        "worker_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/nonempty"}
        }
      }
    }
  }
}
