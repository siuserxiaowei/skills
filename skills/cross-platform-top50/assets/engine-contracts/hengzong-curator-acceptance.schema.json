{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "top50-hengzong-curator-acceptance/v1",
  "title": "Cross-platform Top 50 horizontal/vertical curator acceptance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "run_id",
    "stage",
    "status",
    "curator",
    "brief_binding",
    "reviewed_workstream_ids",
    "accepted_claim_ids",
    "decision",
    "counts",
    "result_digest_sha256"
  ],
  "properties": {
    "contract_version": {"const": "top50-hengzong-curator-acceptance/v1"},
    "run_id": {"$ref": "#/$defs/nonempty"},
    "stage": {"const": "hengzong_curate"},
    "status": {"const": "accepted"},
    "curator": {"$ref": "#/$defs/curator"},
    "brief_binding": {"$ref": "#/$defs/briefBinding"},
    "reviewed_workstream_ids": {"$ref": "#/$defs/idArray"},
    "accepted_claim_ids": {"$ref": "#/$defs/idArray"},
    "decision": {"const": "accepted"},
    "counts": {"$ref": "#/$defs/counts"},
    "result_digest_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "nonempty": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "idArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/nonempty"}
    },
    "curator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["curator_id", "reviewed_at"],
      "properties": {
        "curator_id": {"$ref": "#/$defs/nonempty"},
        "reviewed_at": {"type": "string", "format": "date-time"}
      }
    },
    "briefBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "artifact_sha256",
        "result_digest_sha256"
      ],
      "properties": {
        "contract_version": {"const": "top50-hengzong-brief/v1"},
        "artifact_sha256": {"$ref": "#/$defs/sha256"},
        "result_digest_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewed_workstreams", "accepted_claims"],
      "properties": {
        "reviewed_workstreams": {"type": "integer", "minimum": 1},
        "accepted_claims": {"type": "integer", "minimum": 1}
      }
    }
  }
}
