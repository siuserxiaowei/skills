{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "top50-research-query-plan/v1",
  "title": "Cross-platform research query plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "run_id",
    "topic",
    "purpose",
    "platforms",
    "aliases",
    "languages",
    "intents",
    "timeframe",
    "recent_social_mode",
    "tokenizer_mode",
    "date_policy",
    "fusion_time_policy",
    "idempotency_key",
    "counts",
    "queries",
    "plan_digest_sha256"
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "platform": {
      "enum": [
        "csdn", "wechat_official_accounts", "zhihu", "xiaohongshu",
        "weibo", "douyin", "x", "bilibili", "juejin", "youtube",
        "linuxdo", "github", "baidu_search", "google_search", "bing_search",
        "toutiao", "36kr", "infoq", "segmentfault", "oschina", "v2ex",
        "reddit", "hacker_news", "medium", "linkedin", "kuaishou",
        "wechat_channels", "tiktok"
      ]
    },
    "timeframe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": {"type": "string", "format": "date"},
        "end": {"type": "string", "format": "date"}
      }
    },
    "fusionTimePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "from_date", "to_date"],
      "properties": {
        "mode": {"enum": ["strict", "advisory", "unbounded"]},
        "from_date": {"type": "string", "format": "date"},
        "to_date": {"type": "string", "format": "date"}
      }
    },
    "platformPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform_id", "required", "window_timezone", "query_expansion", "adapter_chain"],
      "properties": {
        "platform_id": {"$ref": "#/$defs/platform"},
        "required": {"type": "boolean"},
        "window_timezone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._+-]+(?:/[A-Za-z0-9._+-]+)*$"
        },
        "query_expansion": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "adapter_chain": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["route_id", "route_kind", "order", "status", "requires_probe", "activation"],
            "properties": {
              "route_id": {"type": "string", "pattern": "^[a-z0-9_]+:(platform_api|platform_cli|authorized_browser|public_discovery)$"},
              "route_kind": {"enum": ["platform_api", "platform_cli", "authorized_browser", "public_discovery"]},
              "order": {"type": "integer", "minimum": 1, "maximum": 4},
              "status": {"const": "planned"},
              "requires_probe": {"const": true},
              "activation": {"enum": ["probe_then_execute", "fallback_after_recorded_outcome"]}
            }
          }
        }
      }
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query_id", "platform_id", "required", "language", "intent",
        "search_query", "ranking_query", "platform_expansion",
        "intent_expansion", "ranking_tokens", "ranking_tokenizer",
        "date_filter", "window_timezone", "unknown_date_policy", "route_plan", "route_plan_status", "status"
      ],
      "properties": {
        "query_id": {"type": "string", "pattern": "^query-[0-9a-f]{24}$"},
        "platform_id": {"$ref": "#/$defs/platform"},
        "required": {"type": "boolean"},
        "language": {"enum": ["zh", "en"]},
        "intent": {
          "enum": [
            "exact", "tutorial", "practice", "review", "case_study",
            "controversy", "failure", "primary_source"
          ]
        },
        "search_query": {"type": "string", "minLength": 1},
        "ranking_query": {"type": "string", "minLength": 1},
        "platform_expansion": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "intent_expansion": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "ranking_tokens": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "ranking_tokenizer": {"enum": ["cjk_bigram", "jieba", "cjk_bigram_fallback"]},
        "date_filter": {"$ref": "#/$defs/timeframe"},
        "window_timezone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._+-]+(?:/[A-Za-z0-9._+-]+)*$"
        },
        "unknown_date_policy": {"const": "isolate"},
        "route_plan": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9_]+:(platform_api|platform_cli|authorized_browser|public_discovery)$"}
        },
        "route_plan_status": {"const": "not_started"},
        "status": {"const": "pending"}
      }
    }
  },
  "properties": {
    "schema": {"const": "top50-research-query-plan/v1"},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$"},
    "topic": {"type": "string", "minLength": 1, "maxLength": 500},
    "purpose": {"type": "string", "minLength": 1, "maxLength": 500},
    "platforms": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/platformPlan"}},
    "aliases": {"type": "array", "maxItems": 20, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "languages": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["zh", "en"]}},
    "intents": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["exact", "tutorial", "practice", "review", "case_study", "controversy", "failure", "primary_source"]}},
    "timeframe": {"$ref": "#/$defs/timeframe"},
    "recent_social_mode": {"enum": ["auto", "strict", "off"]},
    "tokenizer_mode": {"enum": ["cjk_bigram", "jieba"]},
    "date_policy": {"const": "isolate_unknown"},
    "fusion_time_policy": {"$ref": "#/$defs/fusionTimePolicy"},
    "idempotency_key": {"$ref": "#/$defs/sha256"},
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platforms", "queries"],
      "properties": {
        "platforms": {"type": "integer", "minimum": 1},
        "queries": {"type": "integer", "minimum": 1, "maximum": 500}
      }
    },
    "queries": {"type": "array", "minItems": 1, "maxItems": 500, "items": {"$ref": "#/$defs/query"}},
    "plan_digest_sha256": {"$ref": "#/$defs/sha256"}
  }
}
