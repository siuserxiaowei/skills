{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "top50-wigolo-request/v2",
  "title": "Explicit typed read-only Wigolo adapter request",
  "$ref": "#/$defs/request",
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "run_id",
        "selection_mode",
        "operation",
        "allow_experimental_cjk",
        "timeout_seconds",
        "payload"
      ],
      "properties": {
        "contract_version": {"const": "top50-wigolo-request/v2"},
        "run_id": {"type": "string", "minLength": 1},
        "enabled": {"type": "boolean", "default": false},
        "selection_mode": {"enum": ["explicit", "auto"]},
        "operation": {"enum": ["discovery", "fetch", "cache", "watch"]},
        "allow_experimental_cjk": {"type": "boolean"},
        "timeout_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 300},
        "payload": {"type": "object"}
      },
      "allOf": [
        {
          "if": {"properties": {"operation": {"const": "discovery"}}, "required": ["operation"]},
          "then": {"properties": {"payload": {"$ref": "#/$defs/discovery"}}}
        },
        {
          "if": {"properties": {"operation": {"const": "fetch"}}, "required": ["operation"]},
          "then": {"properties": {"payload": {"$ref": "#/$defs/fetch"}}}
        },
        {
          "if": {"properties": {"operation": {"const": "cache"}}, "required": ["operation"]},
          "then": {"properties": {"payload": {"$ref": "#/$defs/cache"}}}
        },
        {
          "if": {"properties": {"operation": {"const": "watch"}}, "required": ["operation"]},
          "then": {"properties": {"payload": {"$ref": "#/$defs/watch"}}}
        }
      ]
    },
    "domainArray": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["query"],
      "properties": {
        "query": {"type": "string", "minLength": 1},
        "max_results": {"type": "integer", "minimum": 1, "maximum": 50},
        "from_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "to_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "include_domains": {"$ref": "#/$defs/domainArray"},
        "exclude_domains": {"$ref": "#/$defs/domainArray"}
      }
    },
    "fetch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url"],
      "properties": {
        "url": {"type": "string", "pattern": "^https?://"},
        "max_chars": {"type": "integer", "minimum": 1, "maximum": 200000},
        "section": {"type": "string", "minLength": 1}
      }
    },
    "cache": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["action"],
          "properties": {"action": {"const": "stats"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["action", "query"],
          "properties": {
            "action": {"const": "search"},
            "query": {"type": "string", "minLength": 1},
            "url_pattern": {"type": "string", "minLength": 1},
            "since": {"type": "string", "minLength": 1},
            "limit": {"type": "integer", "minimum": 1, "maximum": 50},
            "max_tokens_out": {"type": "integer", "minimum": 1, "maximum": 100000}
          }
        }
      ]
    },
    "watch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action"],
      "properties": {"action": {"const": "list"}}
    }
  }
}
