{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "top50-fusion-result/v1",
  "title": "Cross-platform discovery candidate fusion result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "run_id",
    "topic",
    "method",
    "selection_policy",
    "time_policy",
    "selected",
    "quarantined",
    "rejected",
    "summary",
    "result_digest_sha256"
  ],
  "properties": {
    "contract_version": {"const": "top50-fusion-result/v1"},
    "run_id": {"$ref": "#/$defs/nonEmptyText"},
    "topic": {"$ref": "#/$defs/nonEmptyText"},
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "k"],
      "properties": {
        "name": {"const": "weighted_rrf"},
        "k": {"const": 60}
      }
    },
    "selection_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_results",
        "max_per_author",
        "max_first_party_per_author",
        "min_per_platform",
        "scope",
        "evidence_effect"
      ],
      "properties": {
        "max_results": {"type": "integer", "minimum": 1},
        "max_per_author": {"type": "integer", "minimum": 1},
        "max_first_party_per_author": {"type": "integer", "minimum": 1},
        "min_per_platform": {"type": "integer", "minimum": 0},
        "scope": {"const": "discovery_breadth_only"},
        "evidence_effect": {"const": "none"}
      }
    },
    "time_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "from_date", "to_date"],
      "properties": {
        "mode": {"enum": ["strict", "advisory", "unbounded"]},
        "from_date": {"$ref": "#/$defs/isoDate"},
        "to_date": {"$ref": "#/$defs/isoDate"}
      }
    },
    "selected": {
      "type": "array",
      "items": {"$ref": "#/$defs/fusedCandidate"}
    },
    "quarantined": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate_id", "reason_code"],
        "properties": {
          "candidate_id": {"$ref": "#/$defs/nonEmptyText"},
          "reason_code": {
            "enum": [
              "date_unknown",
              "date_not_verified",
              "date_invalid",
              "outside_time_window"
            ]
          }
        }
      }
    },
    "rejected": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate_id", "reason_code"],
        "properties": {
          "candidate_id": {"$ref": "#/$defs/nonEmptyText"},
          "reason_code": {"enum": ["author_diversity_cap", "selection_limit"]},
          "author_id": {"$ref": "#/$defs/nonEmptyText"},
          "cap": {"type": "integer", "minimum": 1}
        },
        "allOf": [
          {
            "if": {"properties": {"reason_code": {"const": "author_diversity_cap"}}},
            "then": {"required": ["author_id", "cap"]},
            "else": {
              "not": {
                "anyOf": [
                  {"required": ["author_id"]},
                  {"required": ["cap"]}
                ]
              }
            }
          }
        ]
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_lists",
        "unique_candidates",
        "eligible_candidates",
        "selected_candidates",
        "quarantined_candidates",
        "rejected_candidates",
        "platform_quota_forced",
        "curator_acceptance_created"
      ],
      "properties": {
        "input_lists": {"type": "integer", "minimum": 1},
        "unique_candidates": {"type": "integer", "minimum": 0},
        "eligible_candidates": {"type": "integer", "minimum": 0},
        "selected_candidates": {"type": "integer", "minimum": 0},
        "quarantined_candidates": {"type": "integer", "minimum": 0},
        "rejected_candidates": {"type": "integer", "minimum": 0},
        "platform_quota_forced": {"type": "integer", "minimum": 0},
        "curator_acceptance_created": {"const": 0}
      }
    },
    "result_digest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "nonEmptyText": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:.*\\S)?$"
    },
    "isoDate": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "rankProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["list_id", "platform", "query_id", "rank", "weight"],
      "properties": {
        "list_id": {"$ref": "#/$defs/nonEmptyText"},
        "platform": {"$ref": "#/$defs/nonEmptyText"},
        "query_id": {"$ref": "#/$defs/nonEmptyText"},
        "rank": {"type": "integer", "minimum": 1},
        "weight": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "fusedCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "url",
        "title",
        "author_id",
        "published_at",
        "date_confidence",
        "source_role",
        "acquisition_method",
        "evidence_status",
        "weighted_rrf_score",
        "rank_provenance",
        "platforms",
        "query_ids",
        "consensus_count",
        "first_party_signal",
        "fusion_signals",
        "curator_accepted"
      ],
      "properties": {
        "candidate_id": {"$ref": "#/$defs/nonEmptyText"},
        "url": {"$ref": "#/$defs/nonEmptyText"},
        "title": {"$ref": "#/$defs/nonEmptyText"},
        "author_id": {"$ref": "#/$defs/nonEmptyText"},
        "published_at": {"$ref": "#/$defs/nonEmptyText"},
        "date_confidence": {"enum": ["verified", "inferred", "unknown"]},
        "source_role": {"$ref": "#/$defs/nonEmptyText"},
        "acquisition_method": {"$ref": "#/$defs/nonEmptyText"},
        "evidence_status": {"const": "discovery_only"},
        "weighted_rrf_score": {"type": "number", "exclusiveMinimum": 0},
        "rank_provenance": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/rankProvenance"}
        },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/nonEmptyText"}
        },
        "query_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/nonEmptyText"}
        },
        "consensus_count": {"type": "integer", "minimum": 1},
        "first_party_signal": {"type": "boolean"},
        "fusion_signals": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["weighted_rrf", "multi_list_consensus", "first_party"]
          }
        },
        "curator_accepted": {"const": false}
      }
    }
  }
}
